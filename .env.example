# Browser key. Restrict this key to your development and production origins.
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_javascript_key

# Kakao JavaScript key for the Places services library.
VITE_KAKAO_JAVASCRIPT_KEY=your_kakao_javascript_key

# P0 backend. Keep local mode until the API server implements the Notion contract.
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_DATA_SOURCE=local

# Social login public client IDs. These are exposed in OAuth authorization URLs;
# keep provider client secrets on the backend only.
VITE_KAKAO_REST_API_KEY=your_kakao_rest_api_key
VITE_GOOGLE_WEB_CLIENT_ID=your_google_web_client_id

# Backend-only values (documented here for matching local environments).
KAKAO_REST_API_KEY=your_kakao_rest_api_key
KAKAO_CLIENT_SECRET=your_server_only_kakao_client_secret
GOOGLE_WEB_CLIENT_ID=your_google_web_client_id
GOOGLE_CLIENT_SECRET=your_server_only_google_client_secret
