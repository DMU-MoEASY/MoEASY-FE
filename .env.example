# Browser key. Restrict this key to your development and production origins.
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_javascript_key

# Kakao JavaScript key for Places search and Kakao Login SDK.
VITE_KAKAO_JAVASCRIPT_KEY=your_kakao_javascript_key

# Spring backend. Every API path is resolved below this HTTPS base URL.
VITE_API_BASE_URL=https://jeonggyul.duckdns.org/api/v1
VITE_DATA_SOURCE=api

# Google OAuth public client ID. Keep provider client secrets on the backend only.
VITE_GOOGLE_WEB_CLIENT_ID=your_google_web_client_id
